{
  "name": "bapi",
  "version": "1.0.50",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "test": "bun test && bun run test:cleanup",
    "test:cleanup": "bun run scripts/cleanup-test-data.ts",
    "db:create-schema": "bun run scripts/create-schema.ts",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:migrate:status": "bun run scripts/migrate.ts status",
    "db:push": "drizzle-kit push",
    "db:push:all": "bun run db:migrate && bun run db:push",
    "mock:data": "bun run scripts/mock-quiz-bids.ts",
    "recalculate:stats": "bun run scripts/recalculate-quiz-stats.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/cron": "^1.4.1",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/server-timing": "^1.4.0",
    "bun-ffmpeg": "^0.2.2",
    "drizzle-orm": "^1.0.0-beta.2-b782ae1",
    "drizzle-typebox": "^0.3.3",
    "elysia": "catalog:backend",
    "exceljs": "^4.4.0",
    "jose": "^6.1.3",
    "luxon": "^3.7.2",
    "node-telegram-bot-api": "^0.67.0",
    "nodemailer": "^7.0.11",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node-telegram-bot-api": "^0.64.13",
    "@types/nodemailer": "^7.0.4",
    "bun-types": "catalog:backend",
    "drizzle-kit": "^1.0.0-beta.2-b782ae1"
  },
  "module": "src/index.js"
}