ENV=development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

JWT_SECRET=your-jwt-secret-key-here
COOKIE_SECRET=your-cookie-secret-key-here

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

MAIL_USER=your-email@example.com
MAIL_PASS=your-email-password
MAIL_HOST=smtp.example.com
MAIL_PORT=465

URL_ORIGIN=
PORT=5001
APP_NAME=Quizgram
APP_URLS=http://localhost:5173,http://localhost:5174

S3_URL=https://s3.example.com
S3_BUCKET_NAME=your-bucket-name
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_SWIFT_URL=https://swift.example.com
S3_SWIFT_ACCESS_KEY=your-swift-access-key
S3_SWIFT_SECRET_ACCESS_KEY=your-swift-secret-access-key
S3_REGION=ru-1

BOT_QUIZ_TOKEN=your-telegram-bot-quiz-token
BOT_CRM_TOKEN=your-telegram-bot-crm-token
CRM_URL=http://localhost:5173
BOT_SUPPORT_TOKEN=your-telegram-bot-support-token

CRYPTO_PAY_TOKEN=your-crypto-pay-token
