ENV=development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

JWT_SECRET=your_jwt_secret_key_here
COOKIE_SECRET=your_cookie_secret_key_here

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

MAIL_USER=your_email@example.com
MAIL_PASS=your_email_password_or_app_password
MAIL_HOST=smtp.example.com
MAIL_PORT=465

# Примеры для популярных провайдеров:
# Yandex: MAIL_HOST=smtp.yandex.ru, используйте пароль приложения!
# Gmail: MAIL_HOST=smtp.gmail.com, используйте пароль приложения!
# Mail.ru: MAIL_HOST=smtp.mail.ru, используйте пароль приложения!

URL_ORIGIN=
PORT=5001
APP_NAME=Quizgram
APP_URLS=http://localhost:5173,http://localhost:5174


S3_URL=https://s3.example.com
S3_BUCKET_NAME=your_bucket_name
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_SWIFT_URL=https://swift.example.com
S3_SWIFT_ACCESS_KEY=your_swift_access_key
S3_SWIFT_SECRET_ACCESS_KEY=your_swift_secret_access_key
S3_REGION=ru-1

BOT_QUIZ_TOKEN=your_telegram_bot_quiz_token
BOT_CRM_TOKEN=your_telegram_bot_crm_token
CRM_URL=https://crm.url
