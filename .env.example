POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"


# Environment flag
IS_DEV=true

# Webhook secret token for Telegram bot
WEBHOOK_SECRET_TOKEN=your_webhook_secret

# App web URL (frontend)
APP_WEB_URL=https://app.quizgram.site

# Environment: production | development
ENV=development

# tg-sender mode: webhook | polling
MODE=webhook

# Internal API base URL (for tg-sender to fetch config)
API_BASE_URL=http://bapi:3000

# Welcome quiz UUID (if not set, fetches from API_BASE_URL)
WELCOME_QUIZ_UUID=

# GitHub MCP Server
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token_here

# Docker Hub авторизация (для CI/CD)
DOCKER_HUB_LOGIN=your_docker_hub_username
DOCKER_HUB_TOKEN=your_docker_hub_access_token
